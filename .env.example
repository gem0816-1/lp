## 数据库（Prisma / MySQL）
DATABASE_URL="mysql://root:password@localhost:3306/spt"

## 服务端端口（Express API）
PORT=3000

## 测量系统参数
MEASUREMENT_LEARNING_RATE=0.18
MEASUREMENT_INFO_THRESHOLD=0.12
MEASUREMENT_CHEAT_PENALTY=0.35

## 冷启动（占位）
SYNTHETIC_SIMULATION_ENABLED=false

## 报告（预留）
REPORT_PREVIEW_LOCK_MINUTES=15

## 外部题库（可选）
QUESTION_BANK_PROVIDER=local
QUESTION_BANK_EXTERNAL_URL=

## OpenAI 出题（可选，仅服务端用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

